{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "maligator-site",
	"main": "worker.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-10",
	"routes": [
		{
			"pattern": "maligator.ddv.tools",
			"zone_name": "ddv.tools",
			"custom_domain": true,
		},
	],
	"durable_objects": {
		"bindings": [{ "name": "MALIGATOR_SITE", "class_name": "MaligatorSite" }],
	},
	"containers": [
		{
			"class_name": "MaligatorSite",
			"image": "../../.cache/site-container/current/Dockerfile",
			"max_instances": 1,
		},
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["MaligatorSite"] }],
}
