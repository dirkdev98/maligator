{
	"name": "maligator",
	"version": "0.1.0-alpha.15",
	"private": true,
	"description": "Ahead-of-time JavaScript compiler and native runtime",
	"homepage": "https://github.com/dirkdev98/maligator#readme",
	"bugs": {
		"url": "https://github.com/dirkdev98/maligator/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dirkdev98/maligator.git"
	},
	"bin": {
		"maligator": "./src/index.ts"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/public-api.d.ts",
			"import": "./src/build.ts"
		}
	},
	"scripts": {
		"bench": "node ./scripts/bench.ts",
		"bench:dx": "node ./scripts/dx-performance.ts",
		"bench:profile-overhead": "node ./scripts/profile-overhead.ts",
		"env:check": "node ./scripts/agent-environment.ts",
		"format": "node ./scripts/quality.ts format",
		"lint": "node ./scripts/quality.ts lint",
		"lint:ci": "node ./scripts/quality.ts lint-ci",
		"release:build": "node ./scripts/release.ts build",
		"release:create-github": "node ./scripts/release.ts create-github",
		"release:pack": "node ./scripts/release.ts pack",
		"release:publish": "node ./scripts/release.ts publish",
		"release:smoke": "node ./scripts/release.ts smoke",
		"release:verify-tag": "node ./scripts/release.ts verify-tag",
		"selfhost:cli": "node ./scripts/selfhost-cli-check.ts",
		"selfhost:frontend": "node ./scripts/selfhost-frontend-check.ts",
		"selfhost:native": "node ./scripts/selfhost-native-build-check.ts",
		"site:build": "node ./scripts/site-build.ts",
		"site:update": "node ./scripts/site-data.ts",
		"test": "node ./scripts/vitest.ts",
		"test262": "node ./scripts/test262.ts --canonical",
		"test262:prepare": "node ./scripts/test262-prepare.ts",
		"test262:regressions": "node ./scripts/test262.ts --canonical --backend wire --manifest tests/test-suite-test262-smoke.txt --manifest tests/test-suite-test262-check.txt --check --policy complete",
		"test262:report": "node ./scripts/test262.ts --canonical --check --policy complete",
		"test:check": "node ./scripts/test-suite.ts check",
		"test:full": "node ./scripts/test-suite.ts full",
		"test:full:report": "node ./scripts/test-suite.ts full --policy complete",
		"test:help": "node ./scripts/test-suite.ts --help",
		"test:leak": "MAL_LEAKCHECK=1 node ./scripts/vitest.ts run --project native tests/native/leak.test.ts",
		"test:native": "node ./scripts/vitest.ts run --project native",
		"test:rust": "node ./scripts/test-rust.ts",
		"test:sanitize": "node ./scripts/test-sanitize.ts",
		"test:smoke": "node ./scripts/test-suite.ts smoke",
		"test:unit": "node ./scripts/vitest.ts --project unit",
		"test:unit:full-only": "node ./scripts/vitest.ts --maligator-unit-full-only --project unit --testTimeout=60000",
		"test:wpt": "node ./scripts/wpt.ts",
		"test:wpt:matrix-report": "node ./scripts/wpt.ts --canonical --mode normal --mode gc-stress --backend compiled --backend interpreted --policy complete",
		"test:wpt:report": "node ./scripts/wpt.ts --canonical --mode normal --backend compiled --policy complete",
		"type-check": "node ./scripts/quality.ts type-check",
		"update": "npx npm-check --update --save-exact",
		"version:alpha": "node ./scripts/release.ts version-alpha"
	},
	"dependencies": {
		"meriyah": "7.1.0",
		"ts-blank-space": "0.9.0"
	},
	"devDependencies": {
		"@lightbase/eslint-config": "4.3.2",
		"@vitest/coverage-v8": "4.1.7",
		"drizzle-orm": "1.0.0-rc.4",
		"express": "5.2.1",
		"oxfmt": "0.52.0",
		"postgres": "3.4.9",
		"supports-color": "7.2.0",
		"typescript": "6.0.3",
		"valibot": "1.4.2",
		"vitest": "4.1.7",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
