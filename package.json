{
	"name": "maligator",
	"version": "0.0.1",
	"private": true,
	"description": "",
	"homepage": "https://github.com/dirkdev98/maligator#readme",
	"bugs": {
		"url": "https://github.com/dirkdev98/maligator/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dirkdev98/maligator.git"
	},
	"type": "module",
	"scripts": {
		"bench": "node ./scripts/bench.ts",
		"format": "oxfmt",
		"gate": "node ./scripts/gate.ts",
		"lint": "eslint . --concurrency=auto --fix --cache --cache-location .cache/eslint/ && oxfmt",
		"lint:ci": "eslint . --concurrency=auto && oxfmt --check",
		"selfhost:frontend": "node ./scripts/selfhost-frontend-check.ts",
		"selfhost:native": "node ./scripts/selfhost-native-build-check.ts",
		"test": "vitest",
		"test262": "node ./scripts/test262.ts",
		"test262:regressions": "node ./scripts/test262.ts --manifest tests/test262-regressions.txt --check",
		"test:leak": "MAL_LEAKCHECK=1 vitest run --project native tests/native/leak.test.ts",
		"test:native": "vitest run --project native",
		"test:unit": "vitest --project unit",
		"type-check": "tsc",
		"update": "npx npm-check --update --save-exact"
	},
	"dependencies": {
		"meriyah": "7.1.0",
		"ts-blank-space": "0.9.0"
	},
	"devDependencies": {
		"@lightbase/eslint-config": "4.3.2",
		"@vitest/coverage-v8": "4.1.7",
		"oxfmt": "0.52.0",
		"typescript": "6.0.3",
		"vitest": "4.1.7",
		"yaml": "2.9.0"
	}
}
