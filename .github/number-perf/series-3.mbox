From dffbbca806b46e19d0f23e084f4b69b01f1bbfd5 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:07:46 +0000
Subject: [PATCH] perf(number): fast-path decimal parseInt numbers


diff --git a/runtime/src/builtin_number.c b/runtime/src/builtin_number.c
index c3ed603..12a46b7 100644
--- a/runtime/src/builtin_number.c
+++ b/runtime/src/builtin_number.c
@@ -247,15 +247,30 @@ static MalValue mal_builtin_number_is_safe_integer(MalVm *vm, MalValue this_valu
 static MalValue mal_builtin_parse_int(MalVm *vm, MalValue this_value, const MalValue *args, i32 arg_count, MalValue new_target, MalValue callee) {
     (void) this_value;
     // ToString(arg) and ToNumber(radix) run a user toString/valueOf (and unwrap
-    // a primitive wrapper), and propagate any abrupt completion.
-    MalString *string;
-    if (!mal_vm_to_string(vm, arg_count >= 1 ? args[0] : mal_value_new_undefined(), &string)) {
+    // a primitive wrapper), and propagate any abrupt completion. A primitive
+    // Number has no observable string coercion, so its common decimal case can
+    // defer allocation until after the radix has been inspected.
+    MalValue input = arg_count >= 1 ? args[0] : mal_value_new_undefined();
+    bool primitive_number = mal_ops_is_number(input);
+    MalString *string = nullptr;
+    if (!primitive_number && !mal_vm_to_string(vm, input, &string)) {
         return mal_value_new_undefined();
     }
     f64 radix = 0;
     if (arg_count >= 2 && !mal_vm_to_number(vm, args[1], &radix)) {
         return mal_value_new_undefined();
     }
+    i32 int_radix = mal_ops_number_to_i32(radix);
+    if (primitive_number && (int_radix == 0 || int_radix == 10)) {
+        f64 number = mal_ops_number_as_f64(input);
+        if (isfinite(number) && trunc(number) == number && fabs(number) < 1e21) {
+            // Number::toString(-0) is "0"; parseInt therefore produces +0.
+            return number == 0.0 ? mal_value_from_i32(0) : input;
+        }
+    }
+    if (string == nullptr && !mal_vm_to_string(vm, input, &string)) {
+        return mal_value_new_undefined();
+    }
     return mal_ops_number_value(mal_builtin_parse_int_units(mal_string_code_units(string), mal_string_length(string), radix));
 }
 
-- 
