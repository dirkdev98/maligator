From 856ef8a5b58a7c69fc2fb2e737e48d5188147b8d Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:13:32 +0000
Subject: [PATCH] perf(number): fast-path integral decimal expansion


diff --git a/runtime/src/number_format.c b/runtime/src/number_format.c
index a6df0dd..738ba68 100644
--- a/runtime/src/number_format.c
+++ b/runtime/src/number_format.c
@@ -84,7 +84,32 @@ static usize mal_decimal_write_u32(u32 value, byte *out) {
     return length;
 }
 
+static usize mal_decimal_write_u64(u64 value, byte *out) {
+    byte reversed[20];
+    usize length = 0;
+    do {
+        reversed[length++] = (byte) ('0' + value % 10u);
+        value /= 10u;
+    } while (value != 0);
+    for (usize i = 0; i < length; i++) {
+        out[i] = reversed[length - i - 1];
+    }
+    return length;
+}
+
 static void mal_decimal_exact(f64 number, MalExactDecimal *out) {
+    // Integer-heavy formatting (toFixed on counters, explicit precision on
+    // identifiers) should not build a 5^N exact expansion. Every integer below
+    // 2^64 converts to u64 exactly; 2^64 itself is excluded so the C cast stays
+    // defined.
+    if (number < 18446744073709551616.0 && trunc(number) == number) {
+        usize length = mal_decimal_write_u64((u64) number, out->digits);
+        out->digits[length] = '\0';
+        out->length = (i32) length;
+        out->scale = 0;
+        out->exponent = (i32) length - 1;
+        return;
+    }
     u64 bits;
     memcpy(&bits, &number, sizeof(bits));
     u64 fraction = bits & 0x000FFFFFFFFFFFFFull;
-- 
