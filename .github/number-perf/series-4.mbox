From 6bef7f46d457f125d497196321ba1ea67ee728fd Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:14:17 +0000
Subject: [PATCH] perf(number): format safe integer radices directly


diff --git a/runtime/src/builtin_number.c b/runtime/src/builtin_number.c
index 21ec285..ea5e6dc 100644
--- a/runtime/src/builtin_number.c
+++ b/runtime/src/builtin_number.c
@@ -315,6 +315,29 @@ static MalValue mal_builtin_global_is_finite(MalVm *vm, MalValue this_value, con
     return mal_value_new_boolean(isfinite(number));
 }
 
+/** Fast exact rendering for the overwhelmingly common safe-integer case. */
+static MalString *mal_builtin_number_safe_integer_radix_string(
+    MalHeap *heap, f64 number, i32 radix
+) {
+    static const byte digits[] = "0123456789abcdefghijklmnopqrstuvwxyz";
+    bool negative = number < 0.0;
+    u64 integer = (u64) (negative ? -number : number);
+    byte reversed[54];
+    usize reversed_length = 0;
+    do {
+        reversed[reversed_length++] = digits[integer % (u64) radix];
+        integer /= (u64) radix;
+    } while (integer != 0);
+
+    byte buffer[55];
+    usize length = 0;
+    if (negative) buffer[length++] = '-';
+    while (reversed_length > 0) {
+        buffer[length++] = reversed[--reversed_length];
+    }
+    return mal_string_new_ascii(heap, buffer, length);
+}
+
 /**
  * Number::toString in a radix 2..36 for a finite value. Renders the integer
  * part by repeated division and up to ~1100 fractional digits by repeated
@@ -399,6 +422,10 @@ static MalValue mal_builtin_number_prototype_to_string(MalVm *vm, MalValue this_
     if (int_radix == 10 || !isfinite(number)) {
         return mal_value_from_string(mal_ops_to_string(&vm->heap, number_value));
     }
+    if (trunc(number) == number && fabs(number) <= MAL_NUMBER_MAX_SAFE_INTEGER) {
+        return mal_value_from_string(
+            mal_builtin_number_safe_integer_radix_string(&vm->heap, number, int_radix));
+    }
 
     return mal_value_from_string(mal_builtin_number_radix_string(&vm->heap, number, int_radix));
 }
-- 
2.47.3
