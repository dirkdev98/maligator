From 3617a12a5bb87def519daff1098cdbed5604919e Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:13:52 +0000
Subject: [PATCH] perf(number): preserve exact toString receivers


diff --git a/runtime/src/builtin_number.c b/runtime/src/builtin_number.c
index 12a46b7..21ec285 100644
--- a/runtime/src/builtin_number.c
+++ b/runtime/src/builtin_number.c
@@ -374,10 +374,11 @@ static MalString *mal_builtin_number_radix_string(MalHeap *heap, f64 number, i32
 static MalValue mal_builtin_number_prototype_to_string(MalVm *vm, MalValue this_value, const MalValue *args, i32 arg_count, MalValue new_target, MalValue callee) {
     (void) new_target;
     (void) callee;
-    f64 number;
-    if (!mal_builtin_number_this(vm, this_value, &number)) {
+    MalValue number_value;
+    if (!mal_builtin_number_this_value(vm, this_value, &number_value)) {
         return mal_value_new_undefined();
     }
+    f64 number = mal_ops_number_as_f64(number_value);
 
     // ToIntegerOrInfinity(radix) via the VM ToNumber, so a poisoned valueOf runs
     // (and a Symbol/BigInt throws TypeError) before the range check. NaN -> 0.
@@ -396,7 +397,7 @@ static MalValue mal_builtin_number_prototype_to_string(MalVm *vm, MalValue this_
 
     i32 int_radix = (i32) radix;
     if (int_radix == 10 || !isfinite(number)) {
-        return mal_value_from_string(mal_ops_to_string(&vm->heap, mal_ops_number_value(number)));
+        return mal_value_from_string(mal_ops_to_string(&vm->heap, number_value));
     }
 
     return mal_value_from_string(mal_builtin_number_radix_string(&vm->heap, number, int_radix));
