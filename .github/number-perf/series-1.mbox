From a2f51c77b966d57cfc6d5544d67ec538faafd199 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:02:30 +0000
Subject: [PATCH] perf(number): avoid transient parseFloat work


diff --git a/runtime/src/builtin_number.c b/runtime/src/builtin_number.c
index 01bcf3a..8c15556 100644
--- a/runtime/src/builtin_number.c
+++ b/runtime/src/builtin_number.c
@@ -75,8 +75,15 @@ static f64 mal_builtin_parse_float_units(const c16 *code_units, usize length) {
         start++;
     }
 
-    // Collect the ASCII prefix and let strtod handle the float grammar.
-    byte *buffer = malloc(length - start + 1);
+    // Collect the ASCII prefix and let strtod handle the float grammar. Most
+    // numeric protocol fields are small, so keep their staging buffer on the
+    // native stack and allocate only for unusually long inputs.
+    usize source_length = length - start;
+    byte stack_buffer[64];
+    byte *buffer = source_length + 1 <= sizeof(stack_buffer)
+        ? stack_buffer
+        : malloc(source_length + 1);
+    bool heap_buffer = buffer != stack_buffer;
     usize buffer_length = 0;
     for (usize i = start; i < length; i++) {
         if (code_units[i] > 0x7F) {
@@ -97,7 +104,7 @@ static f64 mal_builtin_parse_float_units(const c16 *code_units, usize length) {
     // the StrDecimalLiteral grammar does not.
     if (buffer_length >= digits_start + 8 && memcmp(buffer + digits_start, "Infinity", 8) == 0) {
         bool negative = digits_start == 1 && buffer[0] == '-';
-        free(buffer);
+        if (heap_buffer) free(buffer);
         return negative ? -INFINITY : INFINITY;
     }
     if (buffer_length > digits_start && (buffer[digits_start] == 'i' || buffer[digits_start] == 'I' || buffer[digits_start] == 'n' || buffer[digits_start] == 'N')) {
@@ -107,7 +114,7 @@ static f64 mal_builtin_parse_float_units(const c16 *code_units, usize length) {
     byte *end = buffer;
     f64 value = strtod(buffer, (char **) &end);
     bool parsed = end != buffer;
-    free(buffer);
+    if (heap_buffer) free(buffer);
     return parsed ? value : NAN;
 }
 
@@ -254,8 +261,15 @@ static MalValue mal_builtin_parse_int(MalVm *vm, MalValue this_value, const MalV
 
 static MalValue mal_builtin_parse_float(MalVm *vm, MalValue this_value, const MalValue *args, i32 arg_count, MalValue new_target, MalValue callee) {
     (void) this_value;
+    MalValue input = arg_count >= 1 ? args[0] : mal_value_new_undefined();
+    if (mal_ops_is_number(input)) {
+        // ToString(Number) followed by parsing yields the same Number because the
+        // decimal spelling round-trips. The one exception is -0: ToString(-0) is
+        // "0", so parseFloat must return positive zero.
+        return mal_ops_number_as_f64(input) == 0.0 ? mal_value_from_i32(0) : input;
+    }
     MalString *string;
-    if (!mal_vm_to_string(vm, arg_count >= 1 ? args[0] : mal_value_new_undefined(), &string)) {
+    if (!mal_vm_to_string(vm, input, &string)) {
         return mal_value_new_undefined();
     }
     return mal_ops_number_value(mal_builtin_parse_float_units(mal_string_code_units(string), mal_string_length(string)));
-- 
