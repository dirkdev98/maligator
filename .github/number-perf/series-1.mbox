From c894726551c16b829874e825367d9c0ee93c986e Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:01:50 +0000
Subject: [PATCH] perf(number): preserve primitive number values


diff --git a/runtime/src/builtin_number.c b/runtime/src/builtin_number.c
index 75ce4e2..3be37d6 100644
--- a/runtime/src/builtin_number.c
+++ b/runtime/src/builtin_number.c
@@ -124,6 +124,11 @@ static MalValue mal_builtin_number_constructor(MalVm *vm, MalValue this_value, c
     } else if (mal_value_is_symbol(args[0])) {
         mal_vm_throw_error(vm, MAL_INTRINSIC_TYPE_ERROR_PROTOTYPE, "Cannot convert a Symbol value to a number");
         return mal_value_new_undefined();
+    } else if (mal_ops_is_number(args[0])) {
+        // Number primitives already carry the exact ECMAScript value, including
+        // -0, NaN, and the static infinity encodings. Preserve that value rather
+        // than converting through f64 and boxing it again.
+        number = args[0];
     } else if (mal_value_is_object(args[0])) {
         // ToNumber on an object first runs ToPrimitive(number) through the
         // shared coercion path (valueOf/toString/@@toPrimitive), which may throw.
@@ -132,8 +137,6 @@ static MalValue mal_builtin_number_constructor(MalVm *vm, MalValue this_value, c
             return mal_value_new_undefined();
         }
         number = mal_ops_number_value(primitive);
-    } else if (mal_value_is_int32(args[0])) {
-        number = args[0];
     } else {
         number = mal_ops_number_value(mal_ops_to_number(args[0]));
     }
@@ -157,16 +160,23 @@ static MalValue mal_builtin_number_constructor(MalVm *vm, MalValue this_value, c
 }
 
 /**
- * Spec thisNumberValue: unwrap a Number primitive or Number wrapper receiver to
- * its f64, throwing a TypeError on a foreign receiver.
+ * Spec thisNumberValue: unwrap a Number primitive or Number wrapper receiver,
+ * throwing a TypeError on a foreign receiver.
  */
+static bool mal_builtin_number_this_value(MalVm *vm, MalValue this_value, MalValue *out) {
+    if (!mal_value_this_number_value(this_value, out)) {
+        mal_vm_throw_error(vm, MAL_INTRINSIC_TYPE_ERROR_PROTOTYPE, "Number.prototype method called on incompatible receiver");
+        return false;
+    }
+    return true;
+}
+
 static bool mal_builtin_number_this(MalVm *vm, MalValue this_value, f64 *out) {
     MalValue primitive;
-    if (!mal_value_this_number_value(this_value, &primitive)) {
-        mal_vm_throw_error(vm, MAL_INTRINSIC_TYPE_ERROR_PROTOTYPE, "Number.prototype method called on incompatible receiver");
+    if (!mal_builtin_number_this_value(vm, this_value, &primitive)) {
         return false;
     }
-    *out = mal_ops_to_number(primitive);
+    *out = mal_ops_number_as_f64(primitive);
     return true;
 }
 
@@ -693,11 +703,11 @@ static MalValue mal_builtin_number_prototype_value_of(MalVm *vm, MalValue this_v
     (void) arg_count;
     (void) new_target;
     (void) callee;
-    f64 number;
-    if (!mal_builtin_number_this(vm, this_value, &number)) {
+    MalValue number;
+    if (!mal_builtin_number_this_value(vm, this_value, &number)) {
         return mal_value_new_undefined();
     }
-    return mal_ops_number_value(number);
+    return number;
 }
 
 void mal_builtin_number_install(MalVm *vm) {
-- 
