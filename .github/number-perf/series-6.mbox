From ed1d49f9d01060b278150bea5378fbdd038e029a Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 22 Aug 2026 11:17:17 +0000
Subject: [PATCH] perf(number): parse exact integer prefixes natively


diff --git a/runtime/src/builtin_number.c b/runtime/src/builtin_number.c
index 27acfb0..1da5093 100644
--- a/runtime/src/builtin_number.c
+++ b/runtime/src/builtin_number.c
@@ -43,7 +43,9 @@ static f64 mal_builtin_parse_int_units(const c16 *code_units, usize length, f64
         radix = 16;
     }
 
-    f64 value = 0;
+    u64 exact_value = 0;
+    f64 wide_value = 0;
+    bool wide = false;
     bool any_digit = false;
     for (; i < length; i++) {
         c16 code_unit = code_units[i];
@@ -62,10 +64,20 @@ static f64 mal_builtin_parse_int_units(const c16 *code_units, usize length, f64
             break;
         }
 
-        value = value * radix + digit;
+        if (!wide && exact_value <=
+                ((u64) MAL_NUMBER_MAX_SAFE_INTEGER - (u32) digit) / (u32) radix) {
+            exact_value = exact_value * (u32) radix + (u32) digit;
+        } else {
+            if (!wide) {
+                wide_value = (f64) exact_value;
+                wide = true;
+            }
+            wide_value = wide_value * radix + digit;
+        }
         any_digit = true;
     }
 
+    f64 value = wide ? wide_value : (f64) exact_value;
     return any_digit ? sign * value : NAN;
 }
 
-- 
